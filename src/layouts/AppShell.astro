---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideNav?: boolean;
}

const {
  title = 'Drip — Expense Tracker',
  description = 'Liquid aesthetic, habit-aware expense tracker',
  hideNav = false
} = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="min-h-[100dvh] bg-[#E8E9EB] text-white flex items-center justify-center p-0 md:p-6 select-none">
    <!-- Desktop stage container with phone bezel -->
    <div class="w-full max-w-[430px] h-[100dvh] md:h-[880px] md:max-h-[92dvh] bg-black md:rounded-[44px] shadow-2xl relative overflow-hidden flex flex-col border-0 md:border-[10px] md:border-black">
      
      <!-- Main scrollable screen content -->
      <main class="flex-1 w-full h-full overflow-y-auto overflow-x-hidden relative flex flex-col scrollbar-none pt-2">
        <slot />
      </main>

      <!-- Simulated iOS Home Indicator inside desktop frame -->
      <div class="hidden md:flex w-full h-4 absolute bottom-1 left-0 justify-center items-center pointer-events-none z-50">
        <div class="w-[134px] h-[5px] bg-white/80 rounded-full"></div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .scrollbar-none::-webkit-scrollbar {
    display: none;
  }
  /* Hide scrollbar for IE, Edge and Firefox */
  .scrollbar-none {
    -ms-overflow-style: none;  /* IE and Edge */
    scrollbar-width: none;  /* Firefox */
  }
</style>
