---
import AppShell from '../layouts/AppShell.astro';
import ScreenHeader from '../components/ui/ScreenHeader.astro';
import PlanDashboard from '../components/plan/PlanDashboard';
import BottomNav from '../components/ui/BottomNav.astro';
---

<AppShell title="Plan — Drip">
  <div class="w-full flex-1 flex flex-col bg-black text-white relative select-none pb-28">
    <!-- Top Black Header -->
    <ScreenHeader title="Monthly Plan" showBack={true} rightAction="calendar" textColor="text-white" />

    <!-- Live Reactive Plan Island -->
    <PlanDashboard client:load />
  </div>

  <BottomNav currentPath="/plan" />
</AppShell>

