---
import AppShell from '../layouts/AppShell.astro';
import GreetingHeader from '../components/ui/GreetingHeader.astro';
import Drip from '../components/ui/Drip.astro';
import HomeDashboard from '../components/home/HomeDashboard';
import BottomNav from '../components/ui/BottomNav.astro';
---

<AppShell title="Drip — Wallet">
  <div class="w-full flex-1 flex flex-col bg-black text-white relative select-none pb-28">
    <!-- Top Black Header -->
    <GreetingHeader name="Ellie-May" hasUnreadNotifications={true} />

    <!-- Drip Top Edge into Lavender Surface -->
    <Drip variant="top" fill="var(--lavender-500)" seed="home" />

    <!-- Lavender Main Surface -->
    <section class="flex-1 bg-[#B8ACFA] text-black px-5 pt-3 pb-8 flex flex-col gap-5 min-h-[500px]">
      <HomeDashboard client:load />
    </section>
  </div>

  <!-- Bottom Navigation with active Home indicator -->
  <BottomNav currentPath="/" />
</AppShell>
