---
import AppShell from '../layouts/AppShell.astro';
import ScreenHeader from '../components/ui/ScreenHeader.astro';
import AnalyticsDashboard from '../components/analytics/AnalyticsDashboard';
import BottomNav from '../components/ui/BottomNav.astro';
---

<AppShell title="Analytics — Drip">
  <div class="w-full flex-1 flex flex-col bg-black text-white relative select-none pb-28">
    <!-- Top Black Header -->
    <ScreenHeader title="Analytics" showBack={true} rightAction="calendar" textColor="text-white" />

    <!-- Live Reactive Analytics Island -->
    <AnalyticsDashboard client:load />
  </div>

  <BottomNav currentPath="/analytics" />
</AppShell>

