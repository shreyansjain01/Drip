---
import AppShell from '../layouts/AppShell.astro';
import Drip from '../components/ui/Drip.astro';
---

<AppShell title="Welcome to Drip" hideNav={true}>
  <div class="w-full h-full bg-black text-white flex flex-col justify-between relative overflow-hidden select-none">
    
    <!-- Top section: Lavender Drip descending with app logo drop -->
    <div class="relative w-full bg-[#B8ACFA] flex flex-col items-center pt-10 pb-5 text-black">
      <!-- App drop mark icon -->
      <div class="w-15 h-15 rounded-2xl bg-black flex items-center justify-center text-[#B8ACFA] shadow-xl mb-2">
        <svg width="30" height="30" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z" />
        </svg>
      </div>
      <h1 class="text-[34px] leading-tight font-semibold text-black tracking-tight">
        Drip
      </h1>
      <span class="font-caption text-black/70 text-[13px] font-medium">Liquid Expense & Savings Tracker</span>
    </div>

    <!-- Drip bottom edge into Black surface -->
    <Drip variant="bottom" fill="var(--lavender-500)" seed="home" cutoutFill="var(--ink-900)" height={60} />

    <!-- Main content on Black -->
    <div class="flex-1 flex flex-col justify-center px-6 py-5">
      <div class="mb-6 text-center">
        <h2 class="text-[26px] sm:text-[28px] leading-tight font-semibold text-white tracking-tight">
          Effortless money habits.
        </h2>
        <p class="text-white/60 mt-1.5 text-[13.5px] leading-relaxed max-w-[320px] mx-auto">
          Log expenses by voice, track savings goals, and watch your budget thrive in real-time.
        </p>
      </div>

      <!-- Auth Tab Switcher -->
      <div class="w-full bg-[#1A1A1D] p-1 rounded-[18px] flex items-center mb-5 border border-white/10">
        <button
          id="tab-signup"
          type="button"
          class="flex-1 py-2.5 rounded-[14px] text-[14px] font-semibold transition-all bg-[#B8ACFA] text-black shadow-sm cursor-pointer text-center"
        >
          Sign Up
        </button>
        <button
          id="tab-login"
          type="button"
          class="flex-1 py-2.5 rounded-[14px] text-[14px] font-semibold transition-all text-white/70 hover:text-white cursor-pointer text-center"
        >
          Log In
        </button>
      </div>

      <!-- Sign Up View (Default for new users) -->
      <div id="signup-view" class="flex flex-col gap-3 w-full">
        <a
          href="/onboarding"
          id="get-started-btn"
          class="w-full h-14 bg-[#B8ACFA] hover:bg-[#a89af7] text-black font-semibold text-[16px] rounded-[20px] flex items-center justify-center gap-2 pressable shadow-lg active:scale-[0.98] transition-all"
        >
          ✨ Get Started (New Account)
        </a>

        <div class="flex items-center my-1">
          <div class="flex-1 h-[1px] bg-white/10" />
          <span class="px-3 text-[12px] text-white/40 uppercase tracking-wider font-medium">or continue with</span>
          <div class="flex-1 h-[1px] bg-white/10" />
        </div>

        <button
          id="google-signup-btn"
          type="button"
          class="w-full h-13 bg-white hover:bg-white/90 text-black font-medium text-[15px] rounded-[18px] flex items-center justify-center gap-3 pressable shadow-md active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg width="18" height="18" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z" />
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.35 24 12 24z" />
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.98 0 12s.45 3.82 1.25 5.42l4.03-3.15z" />
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z" />
          </svg>
          Google
        </button>
      </div>

      <!-- Log In View -->
      <div id="login-view" class="hidden flex-col gap-3 w-full">
        <button
          id="google-login-btn"
          type="button"
          class="w-full h-14 bg-white hover:bg-white/90 text-black font-semibold text-[15px] rounded-[18px] flex items-center justify-center gap-3 pressable shadow-md active:scale-[0.98] transition-all cursor-pointer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.82-2.4 3.68v3.05h3.88c2.27-2.09 3.66-5.17 3.66-9.17z" />
            <path fill="#34A853" d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.35 24 12 24z" />
            <path fill="#FBBC05" d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.18 0 9.98 0 12s.45 3.82 1.25 5.42l4.03-3.15z" />
            <path fill="#EA4335" d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.42-3.42C17.95 1.19 15.24 0 12 0 7.35 0 3.26 2.64 1.25 6.58l4.03 3.15c.95-2.83 3.6-4.98 6.72-4.98z" />
          </svg>
          Continue with Google
        </button>

        <div class="flex items-center my-1">
          <div class="flex-1 h-[1px] bg-white/10" />
          <span class="px-3 text-[12px] text-white/40 uppercase tracking-wider font-medium">or magic link</span>
          <div class="flex-1 h-[1px] bg-white/10" />
        </div>

        <div class="flex flex-col gap-2">
          <input
            id="email-input"
            type="email"
            placeholder="you@example.com"
            class="w-full h-13 px-4 bg-[#141416] border border-white/15 rounded-[16px] text-white text-[15px] placeholder:text-white/40 focus:border-[#B8ACFA] focus:outline-none"
          />
          <button
            id="email-login-btn"
            type="button"
            class="w-full h-13 bg-[#B8ACFA] hover:bg-[#a89af7] text-black font-semibold text-[15px] rounded-[16px] flex items-center justify-center pressable shadow-md active:scale-[0.98] transition-all cursor-pointer"
          >
            Send Sign In Link
          </button>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="px-6 py-5 text-center">
      <p class="font-caption text-white/35 text-[11.5px]">
        By continuing, you agree to our Terms of Service & Privacy Policy.
      </p>
    </div>
  </div>
</AppShell>

<script>
  import { supabase } from '../lib/supabase/client';

  const tabSignup = document.getElementById('tab-signup');
  const tabLogin = document.getElementById('tab-login');
  const signupView = document.getElementById('signup-view');
  const loginView = document.getElementById('login-view');

  const getStartedBtn = document.getElementById('get-started-btn');
  const googleSignupBtn = document.getElementById('google-signup-btn');
  const googleLoginBtn = document.getElementById('google-login-btn');
  const emailLoginBtn = document.getElementById('email-login-btn');
  const emailInput = document.getElementById('email-input') as HTMLInputElement;

  function switchTab(isSignup: boolean) {
    if (isSignup) {
      tabSignup?.classList.add('bg-[#B8ACFA]', 'text-black', 'shadow-sm');
      tabSignup?.classList.remove('text-white/70');
      tabLogin?.classList.remove('bg-[#B8ACFA]', 'text-black', 'shadow-sm');
      tabLogin?.classList.add('text-white/70');

      signupView?.classList.remove('hidden');
      signupView?.classList.add('flex');
      loginView?.classList.add('hidden');
      loginView?.classList.remove('flex');
    } else {
      tabLogin?.classList.add('bg-[#B8ACFA]', 'text-black', 'shadow-sm');
      tabLogin?.classList.remove('text-white/70');
      tabSignup?.classList.remove('bg-[#B8ACFA]', 'text-black', 'shadow-sm');
      tabSignup?.classList.add('text-white/70');

      loginView?.classList.remove('hidden');
      loginView?.classList.add('flex');
      signupView?.classList.add('hidden');
      signupView?.classList.remove('flex');
    }
  }

  tabSignup?.addEventListener('click', () => switchTab(true));
  tabLogin?.addEventListener('click', () => switchTab(false));

  getStartedBtn?.addEventListener('click', () => {
    // Set cookie session and clean storage for a fresh experience
    document.cookie = 'drip_auth_session=1; path=/; max-age=31536000; SameSite=Lax';
    try {
      localStorage.setItem('drip_local_expenses', JSON.stringify([]));
    } catch {}
  });

  const handleGoogleAuth = async () => {
    document.cookie = 'drip_auth_session=1; path=/; max-age=31536000; SameSite=Lax';
    try {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: {
          redirectTo: `${window.location.origin}/api/auth/callback`
        }
      });
      if (error) {
        window.location.href = '/onboarding';
      }
    } catch {
      window.location.href = '/onboarding';
    }
  };

  googleSignupBtn?.addEventListener('click', handleGoogleAuth);
  googleLoginBtn?.addEventListener('click', handleGoogleAuth);

  emailLoginBtn?.addEventListener('click', async () => {
    const email = emailInput?.value?.trim();
    if (!email) {
      alert('Please enter your email address');
      return;
    }
    document.cookie = 'drip_auth_session=1; path=/; max-age=31536000; SameSite=Lax';
    try {
      const { error } = await supabase.auth.signInWithOtp({
        email,
        options: {
          emailRedirectTo: `${window.location.origin}/onboarding`
        }
      });
      if (error) {
        window.location.href = '/onboarding';
      } else {
        alert('Check your email for the magic sign-in link!');
      }
    } catch {
      window.location.href = '/onboarding';
    }
  });
</script>
